{
  "name": "rechnungstool",
  "version": "1.0.0",
  "description": "Rechnungstool Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "de.rechnungstool.app",
    "productName": "Rechnungstool",
    "icon": "../frontend/public/icon",
    "files": [
      "main.js",
      "../backend/**/*",
      "../frontend/dist/**/*",
      "!../backend/node_modules/.bin",
      "!**/node_modules/.cache"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": ["**/*", "!node_modules/.bin/**"]
      },
      {
        "from": "../frontend/dist",
        "to": "frontend/dist"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "../frontend/public/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.business"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office"
    }
  },
  "dependencies": {
    "electron-is-dev": "^2.0.0"
  },
  "devDependencies": {
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3"
  }
}
